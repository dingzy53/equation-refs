{
	"name": "equation-refs",
	"version": "1.0.1",
	"description": "Number display equations only when they are linked, and show links to them as their numbers.",
	"main": "main.js",
	"type": "module",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
		"lint": "eslint .",
		"test": "vitest run",
		"version": "node version-bump.mjs && git add manifest.json versions.json"
	},
	"keywords": [
		"obsidian-plugin",
		"latex",
		"equation",
		"math"
	],
	"author": "Ding Zheng Yuan",
	"license": "MIT",
	"devDependencies": {
		"@codemirror/language": "^6.13.1",
		"@codemirror/state": "6.7.6",
		"@codemirror/view": "6.43.13",
		"@eslint/js": "^9.39.4",
		"@types/node": "^22.15.17",
		"esbuild": "^0.28.2",
		"eslint": "^9.39.4",
		"eslint-plugin-obsidianmd": "^0.4.2",
		"globals": "^17.13.0",
		"jiti": "^2.7.0",
		"obsidian": "1.14.4",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.72.1",
		"vitest": "^5.0.5"
	}
}
